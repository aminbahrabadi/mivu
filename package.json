{
  "name": "mivu",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal, beautiful, read-only Markdown reader.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "package:deb": "tauri build --bundles deb",
    "package:appimage": "tauri build --bundles appimage"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "markdown-it-task-lists": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
